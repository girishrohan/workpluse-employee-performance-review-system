# WorkPulse Environment Configuration
# Copy this file to .env.local and fill in your values

# =============================================================================
# Supabase Configuration (Required for Database Access)
# =============================================================================

# Supabase project URL (from your Supabase dashboard)
# Example: https://abc123.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous key (for client-side database operations)
# Get from your Supabase dashboard: Settings > Auth > API
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role key (for admin operations that bypass RLS)
# Get from your Supabase dashboard: Settings > Auth > API
# Keep this secret - only use in server-side code
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# =============================================================================
# Authentication Configuration
# =============================================================================

# Secret key for JWT token signing and session encryption
# Generate with: openssl rand -base64 32
# Must be at least 32 characters
AUTH_SECRET=your-32-char-random-secret-here

# =============================================================================
# Flask Configuration (for Python/Streamlit backend)
# =============================================================================

# Flask secret key for session management
SECRET_KEY=your-flask-secret-key

# Default admin password (used on first run)
# Change this in production!
ADMIN_DEFAULT_PASSWORD=Admin@WorkPulse2024

# =============================================================================
# Development Settings
# =============================================================================

# Flask environment
FLASK_ENV=development

# Debug mode (set to False in production)
DEBUG=True

# Host and port for local development
HOST=0.0.0.0
PORT=5000

# =============================================================================
# IMPORTANT NOTES
# =============================================================================
#
# 1. Never commit your real credentials to version control!
# 2. Use .env.local for local development (gitignored by default)
# 3. Use environment variables on Vercel for production
# 4. AUTH_SECRET is used for JWT signing and session encryption
# 5. SUPABASE_SERVICE_ROLE_KEY bypasses RLS - only use in trusted server code
# 6. The app uses standard email/password auth (not Supabase Auth)