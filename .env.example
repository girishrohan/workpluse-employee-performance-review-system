# WorkPulse Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# Supabase Configuration (Production)
# =============================================================================

# Supabase project URL (from your Supabase dashboard)
# Example: https://abc123.supabase.co
SUPABASE_URL=your_supabase_url_here

# Supabase anonymous key (for client-side operations)
# Get from your Supabase dashboard: Settings > Auth > API
SUPABASE_ANON_KEY=your_anon_key_here

# Supabase service role key (for server-side operations)
# Get from your Supabase dashboard: Settings > API > Service Role
# WARNING: Keep this key secret! Never expose to clients.
SUPABASE_SERVICE_KEY=your_service_key_here

# =============================================================================
# JWT Configuration (Optional - for Supabase Auth)
# =============================================================================

# Required for validating Supabase Auth tokens
# Get from: Project Settings > Auth > JWT Secrets
SUPABASE_JWT_SECRET=your_jwt_secret_here

# JWT audience (default: "authenticated")
SUPABASE_JWT_AUDIENCE=authenticated

# =============================================================================
# Database Provider Selection
# =============================================================================

# Set to "supabase" to use Supabase PostgreSQL backend
# Set to "sqlite" for local SQLite database (default)
DATABASE_PROVIDER=sqlite

# =============================================================================
# Authentication Configuration
# =============================================================================

# Flask secret key for session management
SECRET_KEY=your_flask_secret_key_here

# Default admin password (used on first run)
# Change this in production!
ADMIN_DEFAULT_PASSWORD=Admin@WorkPulse2024

# =============================================================================
# Application Settings
# =============================================================================

# Flask environment
FLASK_ENV=production

# Debug mode (set to False in production)
DEBUG=False

# Host and port for local development
HOST=0.0.0.0
PORT=5000